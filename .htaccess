DirectoryIndex glavnaya.html

RewriteEngine On

# http -> https (за nginx-прокси рег.ру признак приходит в X-Forwarded-Proto)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www.prootdyhspb.ru -> prootdyhspb.ru
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# раздел «Горящие туры» снят — старые ссылки ведут на туры по России
RewriteRule ^goryashchie(\.html)?/?$ /tury-po-rossii [R=301,L]

# /index.html или /glavnaya.html -> / (канонический адрес главной)
RewriteCond %{THE_REQUEST} \s/+(index|glavnaya)\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /page.html -> /page (убираем расширение из адресной строки; проверяем только
# исходный запрос браузера через THE_REQUEST, иначе следующее правило зациклится)
RewriteCond %{THE_REQUEST} \s/+([a-z-]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# то же для .php: /akcii.php -> /akcii
RewriteCond %{THE_REQUEST} \s/+([a-z-]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /page -> page.php, если есть; иначе page.html (расширение скрыто от посетителя)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z-]+)/?$ $1.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z-]+)/?$ $1.html [L]
